<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ready_mix_silo_form" model="ir.ui.view">
        <field name="name">ready.mix.silo.form</field>
        <field name="model">ready.mix.silo</field>
        <field name="arch" type="xml">
            <form string="Silo / Storage">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Silo Name"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="plant_id"/>
                            <field name="silo_type"/>
                            <field name="product_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Stock">
                            <field name="capacity_tonnes"/>
                            <field name="current_stock"/>
                            <field name="fill_percentage" widget="progressbar"/>
                            <field name="reorder_point"/>
                        </group>
                    </group>
                    <group string="Calibration">
                        <group>
                            <field name="last_calibration_date"/>
                            <field name="calibration_due_date"/>
                        </group>
                        <group>
                            <field name="calibration_status" widget="badge"
                                   decoration-success="calibration_status == 'valid'"
                                   decoration-warning="calibration_status == 'due_soon'"
                                   decoration-danger="calibration_status == 'overdue'"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ready_mix_silo_list" model="ir.ui.view">
        <field name="name">ready.mix.silo.list</field>
        <field name="model">ready.mix.silo</field>
        <field name="arch" type="xml">
            <list string="Silos">
                <field name="name"/>
                <field name="plant_id"/>
                <field name="silo_type"/>
                <field name="product_id"/>
                <field name="current_stock"/>
                <field name="capacity_tonnes"/>
                <field name="fill_percentage" widget="progressbar"/>
                <field name="reorder_point"/>
                <field name="calibration_due_date"/>
                <field name="calibration_status" widget="badge"
                       decoration-success="calibration_status == 'valid'"
                       decoration-warning="calibration_status == 'due_soon'"
                       decoration-danger="calibration_status == 'overdue'"
                       decoration-muted="calibration_status == 'not_set'"/>
            </list>
        </field>
    </record>

    <record id="action_ready_mix_silo" model="ir.actions.act_window">
        <field name="name">Silos</field>
        <field name="res_model">ready.mix.silo</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
