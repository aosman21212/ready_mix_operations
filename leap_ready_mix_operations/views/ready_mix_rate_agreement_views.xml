<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ready_mix_rate_agreement_form" model="ir.ui.view">
        <field name="name">ready.mix.rate.agreement.form</field>
        <field name="model">ready.mix.rate.agreement</field>
        <field name="arch" type="xml">
            <form string="Rate Agreement">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_expire" string="Mark Expired" type="object"
                            invisible="state not in ('draft','active')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('cancelled','expired')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Parties">
                            <field name="partner_id"/>
                            <field name="jobsite_id"/>
                            <field name="plant_id"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group string="Validity">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Price Lines">
                            <field name="pricelist_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="mix_product_id"/>
                                    <field name="unit_price"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ready_mix_rate_agreement_list" model="ir.ui.view">
        <field name="name">ready.mix.rate.agreement.list</field>
        <field name="model">ready.mix.rate.agreement</field>
        <field name="arch" type="xml">
            <list string="Rate Agreements">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="jobsite_id"/>
                <field name="plant_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'draft'"
                       decoration-muted="state in ('expired','cancelled')"/>
            </list>
        </field>
    </record>

    <record id="action_ready_mix_rate_agreement" model="ir.actions.act_window">
        <field name="name">Rate Agreements</field>
        <field name="res_model">ready.mix.rate.agreement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
