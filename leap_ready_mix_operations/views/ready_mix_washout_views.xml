<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ready_mix_washout_form" model="ir.ui.view">
        <field name="name">ready.mix.washout.form</field>
        <field name="model">ready.mix.washout</field>
        <field name="arch" type="xml">
            <form string="Washout Record">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="plant_id"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="washout_date"/>
                            <field name="washout_time"/>
                            <field name="operator_id"/>
                        </group>
                        <group string="Quantities">
                            <field name="load_id"/>
                            <field name="returned_volume"/>
                            <field name="washout_water_vol"/>
                            <field name="waste_disposal_method"/>
                        </group>
                    </group>
                    <group string="Environmental Notes">
                        <field name="environmental_notes" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Remarks">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ready_mix_washout_list" model="ir.ui.view">
        <field name="name">ready.mix.washout.list</field>
        <field name="model">ready.mix.washout</field>
        <field name="arch" type="xml">
            <list string="Washout Records">
                <field name="name"/>
                <field name="washout_date"/>
                <field name="plant_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="returned_volume"/>
                <field name="washout_water_vol"/>
                <field name="waste_disposal_method"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_ready_mix_washout" model="ir.actions.act_window">
        <field name="name">Washout Records</field>
        <field name="res_model">ready.mix.washout</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
