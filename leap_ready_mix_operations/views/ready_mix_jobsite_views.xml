<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ready_mix_jobsite_form" model="ir.ui.view">
        <field name="name">ready.mix.jobsite.form</field>
        <field name="model">ready.mix.jobsite</field>
        <field name="arch" type="xml">
            <form string="Job Site">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_loads" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="load_count" widget="statinfo" string="Loads"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Site Name"/></h1>
                        <h2><field name="code" placeholder="Site Code (optional)"/></h2>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="partner_id"/>
                            <field name="distance_km"/>
                            <field name="pump_required"/>
                        </group>
                        <group string="Site Contact">
                            <field name="site_engineer"/>
                            <field name="site_phone"/>
                            <field name="site_email" widget="email"/>
                        </group>
                    </group>
                    <group string="Address">
                        <field name="street" placeholder="Street"/>
                        <field name="street2" placeholder="Street2"/>
                        <field name="city" placeholder="City"/>
                        <field name="state_id"/>
                        <field name="country_id"/>
                        <field name="zip" placeholder="ZIP"/>
                    </group>
                    <notebook>
                        <page string="Rate Agreements">
                            <field name="rate_agreement_ids" mode="list">
                                <list>
                                    <field name="name"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="plant_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Special Requirements">
                            <field name="notes" placeholder="Special requirements..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ready_mix_jobsite_list" model="ir.ui.view">
        <field name="name">ready.mix.jobsite.list</field>
        <field name="model">ready.mix.jobsite</field>
        <field name="arch" type="xml">
            <list string="Job Sites">
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="city"/>
                <field name="distance_km"/>
                <field name="pump_required" widget="boolean_toggle"/>
                <field name="load_count"/>
            </list>
        </field>
    </record>

    <record id="action_ready_mix_jobsite" model="ir.actions.act_window">
        <field name="name">Job Sites</field>
        <field name="res_model">ready.mix.jobsite</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
