              sequence="20"/>

    <menuitem id="menu_ready_mix_washout"
              name="Washout Records"
              parent="menu_ready_mix_compliance"
              action="action_ready_mix_washout"
              sequence="30"/>

    <!-- Configuration -->
    <menuitem id="menu_ready_mix_config"
              name="Configuration"
              parent="menu_ready_mix_root"
              sequence="90"
              groups="ready_mix_operations.group_ready_mix_manager"/>

    <menuitem id="menu_ready_mix_plant"
              name="Plants"
              parent="menu_ready_mix_config"
              action="action_ready_mix_plant"
              sequence="10"/>

    <menuitem id="menu_ready_mix_silo"
              name="Silos / Storage"
              parent="menu_ready_mix_config"
              action="action_ready_mix_silo"
              sequence="15"/>

    <menuitem id="menu_ready_mix_product"
              name="Mix Designs"
              parent="menu_ready_mix_config"
              action="action_ready_mix_product"
              sequence="20"/>

    <menuitem id="menu_ready_mix_jobsite"
              name="Job Sites"
              parent="menu_ready_mix_config"
              action="action_ready_mix_jobsite"
              sequence="30"/>
