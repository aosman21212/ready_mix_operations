<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard action using existing list view as fallback -->
    <record id="action_ready_mix_dashboard" model="ir.actions.act_window">
        <field name="name">Operations Dashboard</field>
        <field name="res_model">ready.mix.load</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

    <!-- Sale Order inherited view -->
    <record id="view_sale_order_rm_inherit" model="ir.ui.view">
        <field name="name">sale.order.rm.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_schedules" type="object"
                        class="oe_stat_button" icon="fa-calendar"
                        invisible="schedule_count == 0">
                    <field name="schedule_count" widget="statinfo" string="Schedules"/>
                </button>
                <button name="action_view_loads" type="object"
                        class="oe_stat_button" icon="fa-truck"
                        invisible="load_count == 0">
                    <field name="load_count" widget="statinfo" string="Loads"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='partner_details']" position="after">
                <group name="rm_site_details" string="Ready Mix">
                    <field name="jobsite_id"/>
                    <field name="plant_id"/>
                    <field name="rate_agreement_id"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='other_information']//group[@name='sales_person']" position="after">
                <group string="Ready Mix Review">
                    <field name="technical_reviewed"/>
                    <field name="technical_review_date" readonly="1"/>
                    <field name="technical_reviewer_id" readonly="1"/>
                    <field name="delivered_volume" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
