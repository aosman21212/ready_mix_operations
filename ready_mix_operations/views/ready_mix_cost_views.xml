<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ready_mix_cost_form" model="ir.ui.view">
        <field name="name">ready.mix.cost.sheet.form</field>
        <field name="model">ready.mix.cost.sheet</field>
        <field name="arch" type="xml">
            <form string="Cost Sheet">
                <header>
                    <button name="action_compute_from_plant" string="Compute from Plant Rates"
                            type="object" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Reference">
                            <field name="load_id"/>
                            <field name="plant_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="volume" readonly="1"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group string="Summary">
                            <field name="total_cost" readonly="1"/>
                            <field name="cost_per_m3" readonly="1"/>
                            <field name="revenue" readonly="1"/>
                            <field name="margin" readonly="1"/>
                            <field name="margin_pct" readonly="1" widget="percentage"/>
                            <field name="margin_locked" readonly="1"/>
                        </group>
                    </group>
                    <group string="Cost Breakdown">
                        <group>
                            <field name="material_cost" readonly="1"/>
                            <field name="transport_cost"/>
                            <field name="driver_cost"/>
                        </group>
                        <group>
                            <field name="pump_cost"/>
                            <field name="overhead_cost"/>
                            <field name="other_cost"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cost Lines">
                            <field name="cost_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description"/>
                                    <field name="cost_type"/>
                                    <field name="quantity"/>
                                    <field name="unit"/>
                                    <field name="unit_cost"/>
                                    <field name="subtotal" readonly="1" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ready_mix_cost_list" model="ir.ui.view">
        <field name="name">ready.mix.cost.sheet.list</field>
        <field name="model">ready.mix.cost.sheet</field>
        <field name="arch" type="xml">
            <list string="Cost Sheets">
                <field name="name"/>
                <field name="load_id"/>
                <field name="plant_id"/>
                <field name="partner_id"/>
                <field name="volume"/>
                <field name="total_cost" sum="Total Cost"/>
                <field name="revenue" sum="Total Revenue"/>
                <field name="margin" sum="Total Margin"/>
                <field name="margin_pct"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_ready_mix_cost" model="ir.actions.act_window">
        <field name="name">Cost Sheets</field>
        <field name="res_model">ready.mix.cost.sheet</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
