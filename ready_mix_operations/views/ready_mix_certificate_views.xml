<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ready_mix_certificate_form" model="ir.ui.view">
        <field name="name">ready.mix.certificate.form</field>
        <field name="model">ready.mix.certificate</field>
        <field name="arch" type="xml">
            <form string="Certificate">
                <header>
                    <button name="action_renew" string="Renew" type="object"
                            class="btn-secondary" invisible="status == 'valid'"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Expired" bg_color="bg-danger"
                            invisible="status != 'expired'"/>
                    <widget name="web_ribbon" title="Expiring Soon" bg_color="bg-warning"
                            invisible="status != 'expiring_soon'"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Certificate Name"/></h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="cert_type"/>
                            <field name="reference_no"/>
                            <field name="issuing_body"/>
                            <field name="scope"/>
                        </group>
                        <group string="Holder">
                            <field name="plant_id"/>
                            <field name="partner_id"/>
                            <field name="vehicle_id"/>
                            <field name="employee_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Validity">
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                        </group>
                        <group string="Status">
                            <field name="status" widget="badge" readonly="1"
                                   decoration-success="status == 'valid'"
                                   decoration-warning="status == 'expiring_soon'"
                                   decoration-danger="status == 'expired'"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Documents">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ready_mix_certificate_list" model="ir.ui.view">
        <field name="name">ready.mix.certificate.list</field>
        <field name="model">ready.mix.certificate</field>
        <field name="arch" type="xml">
            <list string="Certificates" decoration-danger="status == 'expired'"
                  decoration-warning="status == 'expiring_soon'">
                <field name="name"/>
                <field name="cert_type"/>
                <field name="reference_no"/>
                <field name="plant_id"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="issuing_body"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'valid'"
                       decoration-warning="status == 'expiring_soon'"
                       decoration-danger="status == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="action_ready_mix_certificate" model="ir.actions.act_window">
        <field name="name">Certificates</field>
        <field name="res_model">ready.mix.certificate</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_ready_mix_certificate_expiring" model="ir.actions.act_window">
        <field name="name">Expiring / Expired Certificates</field>
        <field name="res_model">ready.mix.certificate</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status','in',['expiring_soon','expired'])]</field>
    </record>
</odoo>
