        <!-- ══════════════════════════════════════════════════
             NCR / CAPA
        ══════════════════════════════════════════════════ -->
        <record id="ncr_breach_001" model="ready.mix.ncr">
            <field name="name">NCR/2026/0014</field>
            <field name="load_id" ref="load_breach_01"/>
            <field name="date">2026-08-25</field>
            <field name="source">qc_test</field>
            <field name="severity">major</field>
            <field name="description">Load LT/2026/00035: slump recorded at 45mm (minimum 80mm). Water (15L) added on site without authorisation. Drum revolutions exceeded 300 limit (332). W/C ratio exceeded maximum (0.61 vs 0.60 max). Multiple simultaneous compliance breaches.</field>
            <field name="root_cause">Driver delayed at weighbridge for 90 minutes causing concrete to stiffen. Driver added water without calling plant for authorisation. Weighbridge process does not include a check-call step before water addition.</field>
            <field name="immediate_action">Load acceptance decision escalated to site engineer and QC manager. Additional cube samples taken. Load used for non-structural blinding only after structural engineer approval.</field>
            <field name="corrective_action">1. Retrain all drivers on water-addition prohibition policy.\n2. Install cab-mounted water-addition alert system.\n3. Implement 60-minute on-site timer alert from batching time.</field>
            <field name="preventive_action">Update standing operating procedure to include mandatory plant call before any on-site addition. Add real-time drum revolution monitoring to dispatch system.</field>
            <field name="responsible_id" ref="base.user_admin"/>
            <field name="target_close_date">2026-09-15</field>
            <field name="state">in_progress</field>
        </record>

        <record id="ncr_sample_fail" model="ready.mix.ncr">
